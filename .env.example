# Postgres (Supabase, Neon or any managed Postgres). pg_trgm must be available.
DATABASE_URL=postgres://stayo:stayo@localhost:54329/stayo_quiz

# 32+ random characters. Signs admin cookies.  openssl rand -base64 48
SESSION_SECRET=change-me-change-me-change-me-change-me

# 32-byte key, base64. Encrypts owner/warden contact numbers at rest.  openssl rand -base64 32
CONTACT_ENC_KEY=

# Comma-separated admin access keys for /admin (v1 allowlist).  openssl rand -hex 24
ADMIN_KEYS=

# Public origin used for share links and OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stayo deep links. Leave empty to hide the CTA gracefully.
DISCOVER_BASE_URL=https://yourstayo.com/discover
OWNER_SIGNUP_URL=https://yourstayo.com/owners
TENANT_SIGNUP_URL=https://yourstayo.com/
